# ============================================================
# 悦读灯塔 后端环境变量配置
# 使用方法：复制此文件为 .env，填入真实值
# cp .env.example .env
# ============================================================

# 应用模式（生产环境必须设为 False）
DEBUG=False

# JWT 密钥（生产环境必须修改！）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# 数据库（生产环境使用 PostgreSQL）
DATABASE_URL=postgresql://dyslexia_user:CHANGE_DB_PASSWORD@postgres:5432/dyslexia

# CORS 允许的前端域名
ALLOWED_ORIGINS=http://121.43.250.191

# AI 配置（不填则降级为规则型回复）
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 文件上传目录
UPLOAD_DIR=uploads

# 微信小程序（可选）
WX_APPID=
WX_SECRET=
