# 复制此文件为 .env 并填写配置
# cp .env.example .env

# ── 应用模式 ──────────────────────────────────────────────────────────────
# 生产环境改为 False，会关闭 Swagger 文档、收紧 CORS
DEBUG=False

# ── 数据库 ────────────────────────────────────────────────────────────────
# 默认 SQLite（开发用），生产环境推荐 PostgreSQL
DATABASE_URL=sqlite:///./dyslexia.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dyslexia

# ── JWT 密钥 ──────────────────────────────────────────────────────────────
# 生产环境必须修改！生成命令：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=4f7a217b0b92ca54a2ac384a948a571576d75df3ebcd13d2ef7b82321952feeb

# ── CORS ──────────────────────────────────────────────────────────────────
# 生产环境填写前端域名（逗号分隔），留空时 DEBUG=True 允许所有来源
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://118.145.185.15

# ── AI 配置（可选，不填则使用规则型回复）────────────────────────────────
# OpenAI:
#   AI_API_KEY=sk-xxxx
#   AI_API_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# DeepSeek:
#   AI_API_KEY=sk-xxxx
#   AI_API_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
# 通义千问:
#   AI_API_KEY=sk-xxxx
#   AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-turbo
AI_API_KEY=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
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── 文件上传 ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── 微信小程序（上线微信小程序时必填）────────────────────────────────────
# 在微信公众平台 -> 开发 -> 开发管理 -> 开发设置 中获取
WX_APPID=
WX_SECRET=

# ── 短信服务（可选，不配置则 DEBUG 模式下打印验证码到日志）──────────────────
# 支持 aliyun（阿里云）/ tencent（腾讯云）
# 阿里云：pip install alibabacloud-dysmsapi20170525
#   SMS_PROVIDER=aliyun
#   SMS_ACCESS_KEY=your_access_key_id
#   SMS_SECRET_KEY=your_access_key_secret
#   SMS_SIGN_NAME=悦读小灯塔
#   SMS_TEMPLATE_CODE=SMS_xxxxxxxxx
# 腾讯云：pip install tencentcloud-sdk-python-sms
#   SMS_PROVIDER=tencent
#   SMS_ACCESS_KEY=your_secret_id
#   SMS_SECRET_KEY=your_secret_key
#   SMS_APP_ID=your_sms_app_id
#   SMS_SIGN_NAME=悦读小灯塔
#   SMS_TEMPLATE_CODE=your_template_id
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=悦读小灯塔
SMS_TEMPLATE_CODE=
SMS_APP_ID=
